# Backend base URL, baked in at BUILD time by Vite (import.meta.env).
#
# Local dev: leave this unset/empty. vite.config.js already proxies /api/*
# to the backend (see server.proxy), so the browser never needs an absolute
# URL and there's no CORS to deal with.
#
# Production build (Render static site, Vercel, etc.): there is no dev
# proxy in a built bundle, so this MUST be set to the deployed backend's
# URL or every /api/* call goes against the frontend's own domain and
# fails. Set it as a build-time environment variable in that platform's
# dashboard, not just in a local file — Vite inlines it during `build`.
VITE_API_BASE_URL=https://privacylensproject.onrender.com
