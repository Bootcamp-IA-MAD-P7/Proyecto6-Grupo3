# Comma-separated list of origins allowed to call this API (CORS).
# Never set this to "*" (specs/5_backend_contract.md, SEGURIDAD).
# In local dev this is the Vite dev server (frontend/vite.config.js).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Cloud Translation API (v2) key, used by app/translation.py to
# translate Spanish policies to English before classification. Optional:
# if unset, Spanish input is classified untranslated (noisy but no error).
# Get one at console.cloud.google.com (enable "Cloud Translation API",
# then Credentials -> Create credentials -> API key, restrict it to that API).
GOOGLE_TRANSLATE_API_KEY=
